library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

-- Uncomment the following library declaration if using
-- arithmetic functions with Signed or Unsigned values
use IEEE.NUMERIC_STD.ALL;
use ieee.std_logic_unsigned.all
;
-- Uncomment the following library declaration if instantiating
-- any Xilinx leaf cells in this code.
--library UNISIM;
--use UNISIM.VComponents.all;

entity ALU is
    Port ( A : in STD_LOGIC_VECTOR (7 downto 0);
           B : in STD_LOGIC_VECTOR (7 downto 0);
           Cmd : in STD_LOGIC_VECTOR (3 downto 0);
           F : out STD_LOGIC_VECTOR (7 downto 0);
           N : out STD_LOGIC;
           C : out STD_LOGIC;
           Z : out STD_LOGIC);
end ALU;

architecture ALU of ALU is

-- ALU instructions
constant NOP : std_logic_vector(3 downto 0) := "0000";
constant XORA: std_logic_vector(3 downto 0) := "0001";
constant INCA: std_logic_vector(3 downto 0) := "0010";
constant DECA: std_logic_vector(3 downto 0) := "0011";
constant ANDA: std_logic_vector(3 downto 0) := "0100";
constant ORA:  std_logic_vector(3 downto 0) := "0101";
constant ADDA: std_logic_vector(3 downto 0) := "0110";
constant SUBA: std_logic_vector(3 downto 0) := "0111";
constant LDA : std_logic_vector(3 downto 0) := "1000";

begin
    process (A, B, Cmd)
    
    variable F9: std_logic_vector(8 downto 0);
    variable F8: std_logic_vector(7 downto 0);

    begin
    
      
        case Cmd is
            when LDA => 
                F8 := B; ---LDA
             when XORA => 
                F8 := A XOR B; ---XORA
                           
             ---------------------------------------
             when INCA =>
             --F9
                --F9 := ('0'&A) + ('0'&B); --A + 1; --INCA (increase A)
                F9 := ('0'&A) + ('0'&"00000001"); --A + 1; --INCA (increase A)
                F8 := F9(7 downto 0);
                C <= F9(8);
             when DECA =>
                --F9
                F9 := ('0'&A) + ('0'&(not("00000001") + 1));--A - 1; --DECA (decrease A)
                F8 := F9(7 downto 0);
                C <= F9(8);
                
                
             ----------------------------------------
             when ANDA =>
                F8 := A and B; --A and B
             when ORA =>
                F8 := A or B; --A + B
                
             ---------------------------------------
             when ADDA =>
             --F9
                F9 := ('0'&A) + ('0'&B); --A + B; --ADDA
                F8 := F9(7 downto 0);
                C <= F9(8);
             when SUBA =>
             --F9
                F9 := ('0'&A) + ('0'&(not(B) + 1)); --A - B; (Make B negative and add it to A)
                F8 := F9(7 downto 0);
                C <= F9(8);
             when others =>
             
        end case;
                F <= F8;
                N <= F8(7);
                
                if F8 = "00000000" then
                    Z <= '1';
                else
                    Z <= '0';
                end if;   
                
    end process;
    
end ALU;
